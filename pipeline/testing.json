{
	"name": "testing",
	"properties": {
		"activities": [
			{
				"name": "LookupParameter",
				"type": "Lookup",
				"dependsOn": [
					{
						"activity": "Parameter",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "JsonSource",
						"storeSettings": {
							"type": "AzureBlobFSReadSettings",
							"recursive": true,
							"enablePartitionDiscovery": false
						},
						"formatSettings": {
							"type": "JsonReadSettings"
						}
					},
					"dataset": {
						"referenceName": "cdc",
						"type": "DatasetReference",
						"parameters": {
							"container": "bronze",
							"directory": "parameter",
							"file": "parameter.json"
						}
					},
					"firstRowOnly": false
				}
			},
			{
				"name": "ForEachParams",
				"type": "ForEach",
				"dependsOn": [
					{
						"activity": "LookupParameter",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"items": {
						"value": "@activity('LookupParameter').output.value",
						"type": "Expression"
					},
					"isSequential": true,
					"activities": [
						{
							"name": "Execute PipelineincreamentalLoad",
							"type": "ExecutePipeline",
							"dependsOn": [],
							"policy": {
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"pipeline": {
									"referenceName": "incremental_ingestion",
									"type": "PipelineReference"
								},
								"waitOnCompletion": true,
								"parameters": {
									"schema": {
										"value": "@item().schema",
										"type": "Expression"
									},
									"table": {
										"value": "@item().table",
										"type": "Expression"
									},
									"cdc": {
										"value": "@item().cdc",
										"type": "Expression"
									}
								}
							}
						}
					]
				}
			},
			{
				"name": "Parameter",
				"type": "Copy",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "JsonSource",
						"storeSettings": {
							"type": "HttpReadSettings",
							"requestMethod": "GET"
						},
						"formatSettings": {
							"type": "JsonReadSettings"
						}
					},
					"sink": {
						"type": "JsonSink",
						"storeSettings": {
							"type": "AzureBlobFSWriteSettings"
						},
						"formatSettings": {
							"type": "JsonWriteSettings"
						}
					},
					"enableStaging": false
				},
				"inputs": [
					{
						"referenceName": "github_connect",
						"type": "DatasetReference"
					}
				],
				"outputs": [
					{
						"referenceName": "cdc",
						"type": "DatasetReference",
						"parameters": {
							"container": "bronze",
							"directory": "parameter",
							"file": "parameter.json"
						}
					}
				]
			}
		],
		"annotations": []
	}
}