{
    "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
    "contentVersion": "1.0.0.0",
    "parameters": {
        "workspaces_datatransformer_name": {
            "defaultValue": "datatransformer",
            "type": "String"
        }
    },
    "variables": {},
    "resources": [
        {
            "type": "Microsoft.Databricks/workspaces",
            "apiVersion": "2026-01-01",
            "name": "[parameters('workspaces_datatransformer_name')]",
            "location": "westus3",
            "sku": {
                "name": "premium"
            },
            "properties": {
                "computeMode": "Hybrid",
                "defaultCatalog": {
                    "initialType": "UnityCatalog"
                },
                "managedResourceGroupId": "[concat('/subscriptions/31d1bcf0-b9a6-40f2-95a6-ac1e48ab0bfe/resourceGroups/databricks-rg-', parameters('workspaces_datatransformer_name'), '-ejoxovstofzuw')]",
                "parameters": {
                    "enableNoPublicIp": {
                        "type": "Bool",
                        "value": true
                    },
                    "prepareEncryption": {
                        "type": "Bool",
                        "value": false
                    },
                    "requireInfrastructureEncryption": {
                        "type": "Bool",
                        "value": false
                    },
                    "storageAccountName": {
                        "type": "String",
                        "value": "dbstoragepocgu6aq4nab4"
                    },
                    "storageAccountSkuName": {
                        "type": "String",
                        "value": "Standard_ZRS"
                    }
                },
                "authorizations": [
                    {
                        "principalId": "9a74af6f-d153-4348-988a-e2672920bee9",
                        "roleDefinitionId": "8e3af657-a8ff-443c-a75c-2fe8c4bcb635"
                    }
                ],
                "createdBy": {},
                "updatedBy": {}
            }
        }
    ]
